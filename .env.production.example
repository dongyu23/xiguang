# 生产部署模板：复制为服务器部署目录中的 .env，只填写密钥和真实域名。
# BACKEND_IMAGE 由 CI/CD 以不可变 digest 注入，无需人工维护。
HTTP_PORT=8088
HTTPS_PORT=8443

APP_ENV=production
APP_PORT=8080
JWT_SECRET=replace_with_64char_random_string_before_real_deploy_please
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h
ALLOWED_ORIGIN=https://api.frozenfish.cn

DB_HOST=postgres
DB_PORT=5432
DB_USER=glimmer
DB_PASSWORD=glimmer_dev_password
DB_NAME=glimmer
DB_SSLMODE=disable

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=https://api.frozenfish.cn/glimmer-media
MINIO_ACCESS_KEY=glimmer_minio
MINIO_SECRET_KEY=glimmer_minio_password
MINIO_BUCKET=glimmer-media
MINIO_USE_SSL=false
MINIO_PRESIGN_UPLOAD_TTL=5m
MINIO_PRESIGN_DOWNLOAD_TTL=5m
MEDIA_MAX_IMAGE_SIZE=10485760
MEDIA_MAX_AUDIO_SIZE=52428800
MEDIA_IMAGE_FORMATS=JPEG,PNG,HEIC,WebP
MEDIA_AUDIO_FORMATS=M4A,AAC,MP3,WAV

AI_PROVIDER=deepseek
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_DEEPSEEK_MODEL=deepseek-chat
AI_MAX_TOKENS=2048
AI_TIMEOUT=60s
AI_DAILY_QUOTA_PER_USER=50

ASR_PROVIDER=tencent
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_REGION=ap-shanghai
TENCENT_ASR_ENDPOINT=asr.tencentcloudapi.com
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh
TENCENT_ASR_REALTIME_HOST=asr.cloud.tencent.com

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_SAMPLE_RATE=1.0

# ─── App 在线更新（app_release 模块）───
# 发布的 APK 文件存放目录（宿主机路径，nginx.conf 里 alias 指向同一路径）。
# 发布脚本把 APK scp 到这里，后端 service 校验文件存在性。
RELEASE_STATIC_DIR=/var/xiguang/app-releases
# 客户端下载 APK 时拼接的前缀 URL。生产环境应改成对外可访问的 https 域名。
# 留空时默认 /media/app，走 nginx 反向代理到静态目录。
RELEASE_DOWNLOAD_BASE=https://api.frozenfish.cn/media/app

# ─── 付费与会员 ───
PAYMENT_ENABLED=false
PAYMENT_ENV=production
PAYMENT_CHANNELS=apple
PAYMENT_PUBLIC_BASE_URL=https://api.frozenfish.cn
# 至少 32 字符随机值；也可使用 PAYMENT_DATA_ENCRYPTION_KEY_FILE。
# 下列所有支付密钥均支持同名变量加 _FILE，例如 APPLE_PRIVATE_KEY_BASE64_FILE=/run/secrets/apple_key。
# 支付开关、环境、渠道列表和公网地址也支持同名 `_FILE`。
PAYMENT_DATA_ENCRYPTION_KEY=
TLS_CERT_BASE64=
TLS_KEY_BASE64=

APPLE_BUNDLE_ID=com.xiguang.xiguang
# App Store Connect 中 App 资源 ID，不是 Bundle ID。
APPLE_APP_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_BASE64=

WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_PRIVATE_KEY_BASE64=
WECHAT_PAY_API_V3_KEY=
# 自动续费资质获批后由微信支付分配的委托代扣计划 ID。
WECHAT_PAY_PLAN_ID=
# 资格产品接口路径通常无需修改；若商户后台下发专属路径可直接覆盖。
WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com
WECHAT_PAY_CONTRACT_PATH=/v3/papay/contracts/app-pre-entrust-sign
WECHAT_PAY_CHARGE_PATH=/v3/papay/transactions
WECHAT_PAY_QUERY_PATH=/v3/papay/transactions/out-trade-no/{out_trade_no}
WECHAT_PAY_CANCEL_PATH=/v3/papay/contracts/{contract_id}/terminate

ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY_BASE64=
# 支付宝开放平台下载的“应用公钥证书”，证书模式必需。
ALIPAY_APP_PUBLIC_CERT_BASE64=
ALIPAY_PUBLIC_CERT_BASE64=
ALIPAY_ROOT_CERT_BASE64=
# 周期扣款产品码，以支付宝签约后台实际获批值为准（常见为 CYCLE_PAY_AUTH_P）。
ALIPAY_PERSONAL_PRODUCT_CODE=
ALIPAY_SIGN_SCENE=INDUSTRY|DEFAULT
# 可留空自动随 PAYMENT_ENV 选择；也可显式覆盖渠道网关。
ALIPAY_GATEWAY=

# Android release 构建机环境变量（不要提交 keystore）。
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
