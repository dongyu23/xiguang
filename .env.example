APP_ENV=development
APP_PORT=8080
JWT_SECRET=replace_with_64char_random_string_before_real_deploy_please
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h
ALLOWED_ORIGIN=*

DB_HOST=postgres
DB_PORT=5432
DB_USER=glimmer
DB_PASSWORD=glimmer_dev_password
DB_NAME=glimmer
DB_SSLMODE=disable

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=glimmer_minio
MINIO_SECRET_KEY=glimmer_minio_password
MINIO_BUCKET=glimmer-media
MINIO_USE_SSL=false
MINIO_PRESIGN_UPLOAD_TTL=5m
MINIO_PRESIGN_DOWNLOAD_TTL=5m
MEDIA_MAX_IMAGE_SIZE=10485760
MEDIA_MAX_AUDIO_SIZE=52428800
MEDIA_IMAGE_FORMATS=JPEG,PNG,HEIC,WebP
MEDIA_AUDIO_FORMATS=M4A,AAC,MP3,WAV

AI_PROVIDER=deepseek
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_DEEPSEEK_MODEL=deepseek-chat
AI_MAX_TOKENS=2048
AI_TIMEOUT=60s
AI_DAILY_QUOTA_PER_USER=50

ASR_PROVIDER=tencent
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_REGION=ap-shanghai
TENCENT_ASR_ENDPOINT=asr.tencentcloudapi.com
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh
TENCENT_ASR_REALTIME_HOST=asr.cloud.tencent.com

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_SAMPLE_RATE=1.0

# ─── App 在线更新（app_release 模块）───
# 发布的 APK 文件存放目录（宿主机路径，nginx.conf 里 alias 指向同一路径）。
# 发布脚本把 APK scp 到这里，后端 service 校验文件存在性。
RELEASE_STATIC_DIR=/var/xiguang/app-releases
# 客户端下载 APK 时拼接的前缀 URL。生产环境应改成对外可访问的 https 域名。
# 留空时默认 /media/app，走 nginx 反向代理到静态目录。
RELEASE_DOWNLOAD_BASE=https://your-domain/media/app
